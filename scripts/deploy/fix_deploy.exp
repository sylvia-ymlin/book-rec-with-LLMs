#!/usr/bin/expect

set host "connect.nmb2.seetacloud.com"
set port "15054"
set user "root"
set password "9Dml+WZeqp5b"
set local_dir "."
set remote_dir "/root/autodl-tmp/book-rec-with-LLMs"

# Fix: Upload src/model specifically
spawn ssh -p $port $user@$host "mkdir -p $remote_dir/src/model"
expect {
    "password:" { send "$password\r" }
    "continue connecting" { send "yes\r"; exp_continue }
}
expect eof

spawn scp -P $port -r $local_dir/src/model $user@$host:$remote_dir/src/
expect {
    "password:" { send "$password\r" }
}
expect eof

puts "Fix Deployment Complete!"
